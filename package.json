{
  "name": "auto-caption-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local web tool: auto caption video dengan gaya CapCut (Pop Bounce) lalu burn-in ke MP4.",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @acs/shared build && concurrently -k -n api,web -c blue,green \"pnpm --filter @acs/api dev\" \"pnpm --filter @acs/web dev\"",
    "build": "pnpm --filter @acs/shared build && pnpm --filter @acs/api build && pnpm --filter @acs/web build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "doctor": "pnpm --filter @acs/shared build && pnpm --filter @acs/api run doctor",
    "db:push": "pnpm --filter @acs/api db:push",
    "setup:py": "node scripts/setup-python.mjs",
    "fetch:model": "node scripts/fetch-model.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.18.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.4.1"
  }
}
