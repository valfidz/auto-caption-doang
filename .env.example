# --- Database -------------------------------------------------------------
# Default (bila kosong): file:<DATA_DIR>/app.db
# DATABASE_URL="file:./data/app.db"

# --- Storage --------------------------------------------------------------
# Default: <repo>/data
# DATA_DIR=

# --- External binaries ----------------------------------------------------
# Default: ffmpeg / ffprobe dari PATH
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# Default: deteksi (.venv di repo, lalu python/python3 dari PATH)
# PYTHON_PATH=

# --- Transcription --------------------------------------------------------
# Nama model faster-whisper atau path direktori model lokal.
WHISPER_MODEL=large-v3
# cuda | cpu. Fallback otomatis ke cpu bila CUDA tidak tersedia.
WHISPER_DEVICE=cuda
# float16 | int8 | int8_float16
WHISPER_COMPUTE=float16
# Direktori cache model HuggingFace (default: <repo>/data/models)
# HF_HOME=

# --- Assets ---------------------------------------------------------------
# Default: <repo>/assets/fonts
# FONTS_DIR=

# --- Housekeeping ---------------------------------------------------------
TEMP_TTL_DAYS=7

# --- Servers --------------------------------------------------------------
PORT=3001
