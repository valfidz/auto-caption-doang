{
  "name": "@acs/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API Auto Caption Studio (NestJS) + runner job in-process.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,node -c gray,blue \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "doctor": "tsc -p tsconfig.build.json && node dist/cli/doctor.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/db-generate.mjs",
    "db:push": "node scripts/db-push.mjs"
  },
  "dependencies": {
    "@acs/shared": "workspace:*",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "streamsearch": "^1.1.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "concurrently": "^10.0.6",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
